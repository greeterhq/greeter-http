# Bundler
/.bundle/
/vendor/bundle/
/vendor/cache/

# Gems built locally
*.gem

# Ruby version managers
# .ruby-version is intentionally tracked so the Ruby pin (3.3.x) is shared.
.ruby-gemset
.rvmrc

# Environment / secrets
.env
.env.*
!.env.example
# Local sam-local env file (per-developer); copy from env.json.example.
/env.json

# Test & coverage artifacts
/coverage/
/spec/examples.txt
/.rspec_status
rspec_examples.txt

# Perf baseline is a PER-ENVIRONMENT measurement (laptop vs CI runner differ),
# recorded on first run and cached per-branch in CI. Committing it would make
# one machine's numbers the baseline for all, causing false cross-environment
# regression failures.
/perf/baseline.json

# RuboCop cache
/.rubocop-cache/
.rubocop-https*

# Security tooling output
/brakeman-output.*

# Serverless / SAM / build artifacts
/.serverless/
/.aws-sam/
/.lambda/
/pkg/
/tmp/
*.zip
# `sam deploy --guided` writes this locally (pins a stack name, personal AWS
# profile, and s3 prefix). CD passes --stack-name/--region explicitly and must
# never inherit a committed config, so keep it out of the repo and the artifact.
/samconfig.toml

# Logs
*.log
/log/

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
*.iml
.vscode/

# Kiro local caches (keep steering, hooks, specs tracked)
.kiro/**/cache/
