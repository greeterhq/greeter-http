{
  "version": "v1",
  "hooks": [
    {
      "name": "run-related-spec-on-save",
      "description": "Run the unit suite whenever lib/ changes",
      "trigger": "PostFileSave",
      "matcher": "lib/greeter_http/.*\\.rb$",
      "action": {
        "type": "command",
        "command": "bundle exec rspec --fail-fast --format progress"
      },
      "timeout": 120
    },
    {
      "name": "rubocop-on-save",
      "trigger": "PostFileSave",
      "matcher": "\\.rb$",
      "action": { "type": "command", "command": "bundle exec rubocop -A --fail-level E" }
    },
    {
      "name": "protect-tests-during-apply",
      "description": "Block agent writes to spec/ and features/ unless I approve",
      "trigger": "PreToolUse",
      "matcher": "fs_write|str_replace|fs_append",
      "action": { "type": "command", "command": "bin/guard-test-edits" }
    },
    {
      "name": "full-suite-when-agent-stops",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "bundle exec rspec && bundle exec cucumber && openspec validate --all --strict --no-interactive"
      },
      "timeout": 300
    }
  ]
}
